; User visible strings
;-------------------------------------------------
[Strings]
Bundle = "Intel(R) Connectivity Performance Suite DCHU Component Installation Disk"
IntelCoServiceName  = "INTCCoSvc"
IntelCoServiceDesc  = "Intel Connectivity Traffic Control Callout"
ICPS_Service = "Intel Connectivity Network Service"
ICPSComponent = "Intel(R) Connectivity Performance Suite"
ICPSServiceDesc = "Intel Connectivity Network Service provides network enhancements and optimizations"
ICPSAnalyticsService = "Intel Analytics Service"
ICPSAnalyticsServiceDesc = "Intel Analytics Service"
ICPSProviderDataHelperService = "Intel Provider Data Helper Service"
ICPSProviderDataHelperServiceDesc = "Intel Provider Data Helper Service"
ICService = "IntelConnectService"
ICServiceDisplayName = "IntelConnect Service"
ICServiceDesc = "Provides a service which automatically connects to the best known WiFi AP."
IDBWMService = "IDBWM"
IDBWMServiceDisplayName = "Intel Dynamic Bandwidth Management"
IDBWMServiceDesc = "This service dynamically manages bandwidth settings based on detection of internet traffic congestion."
IntelCorp = "Intel Corporation"
